{
  "name": "engaje-midia-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:http": "node --import tsx scripts/verify-release-http.ts",
    "verify:schema": "node --import tsx scripts/verify-schema.ts",
    "verify:local-migrations": "node --import tsx scripts/audit-migration-history.ts --local-only",
    "types:generate": "node --import tsx scripts/generate-types.ts",
    "types:generate:functions": "node --import tsx scripts/generate-types.ts --functions-only",
    "typecheck": "tsc --noEmit && npm run typecheck:edge-auth",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test tests/*.test.ts",
    "prebuild": "npm run test && npm run typecheck",
    "check:architecture": "node --import tsx scripts/check-architecture.ts",
    "lint": "node scripts/lint.mjs",
    "verify:staging": "node --import tsx scripts/verify-staging-isolation.ts",
    "verify:production-isolation": "node --import tsx scripts/verify-production-isolation.ts",
    "verify:authenticated-http": "node --import tsx scripts/verify-authenticated-http.ts",
    "typecheck:edge-auth": "tsc --noEmit --skipLibCheck --target ES2022 --module esnext --moduleResolution bundler supabase/functions/_shared/agency-authorization.ts supabase/functions/_shared/tenant-storage.ts",
    "verify:migration-history": "node --import tsx scripts/audit-migration-history.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.18.6",
    "@types/papaparse": "5.3.16",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.2",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.76.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "16.4.3",
    "papaparse": "5.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "tailwind-merge": "2.6.0",
    "zod": "4.6.7"
  }
}
